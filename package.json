{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first bilingual webpage translator with ChatGPT sign-in and custom APIs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "install:host": "tsx scripts/install-host.ts",
    "uninstall:host": "tsx scripts/install-host.ts --uninstall",
    "test:browser": "tsx scripts/test-browser.ts",
    "test:recovery": "npm run build && tsx scripts/test-recovery.ts",
    "test:native": "npm run build && tsx scripts/test-native.ts",
    "benchmark:status": "tsx scripts/benchmark-status.ts",
    "benchmark:browser": "tsx scripts/test-browser.ts --benchmark",
    "benchmark:dynamic": "tsx scripts/benchmark-dynamic.ts",
    "performance:report": "tsx scripts/analyze-performance.ts"
  },
  "dependencies": {
    "jose": "6.2.13",
    "proper-lockfile": "4.1.2",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
